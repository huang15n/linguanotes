# Development defaults only. Replace before deployment.
MYSQL_ROOT_PASSWORD=change-me-local
DB_USER=linguanotes
DB_PASSWORD=change-me-local
COOKIE_SECURE=false
APP_PUBLIC_URL=http://localhost:4200

# OpenAI-compatible provider; blank disables AI.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# SMTP; required for password reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@linguanotes.local

# Optional bootstrap admin; created only if the account does not exist.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
